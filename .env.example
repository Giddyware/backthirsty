# Copy to .env.local and fill in. Nothing here is required to run the marketing
# page; each variable gates one feature and fails with a message naming it.
#
# On Vercel, set these per environment (Production / Preview / Development) —
# not once globally. Preview should point at a Neon branch so previews never
# touch production data.

# ---------------------------------------------------------------------------
# Market data mode
# ---------------------------------------------------------------------------
# `fixtures` serves canned provider responses from lib/market/__fixtures__ and
# makes zero network calls. `live` hits the real APIs.
#
# Keep this on `fixtures` for day-to-day local work. Alpha Vantage's free tier
# is 25 requests/day, and a watch-mode test run pointed at `live` will exhaust
# it in seconds. Tests force `fixtures` regardless of what is set here.
MARKET_DATA_MODE=fixtures

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Database — Neon (free tier: 0.5 GB, scale-to-zero after ~5 min idle)
# ---------------------------------------------------------------------------
# https://neon.tech → create project → connection string (pooled).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth — OAuth only
# ---------------------------------------------------------------------------
# There is deliberately no email provider: sending to arbitrary addresses
# requires a DNS-verified domain, which backthirsty.vercel.app can never be.
# So sign-in is GitHub + Google OAuth, with no magic links and no passwords.

# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# IMPORTANT: register BOTH callback URLs on each OAuth app, or sign-in will
# work in exactly one environment:
#   http://localhost:3001/api/auth/callback/<provider>
#   https://backthirsty.vercel.app/api/auth/callback/<provider>

# https://github.com/settings/developers → New OAuth App
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# https://console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Market data providers
# ---------------------------------------------------------------------------

# Alpha Vantage — 25 requests/day. Powers stock BACKTEST MATH via
# TIME_SERIES_MONTHLY_ADJUSTED, the only free source of adjusted closes
# (DAILY_ADJUSTED is premium, and unadjusted data yields wrong long-run
# returns). This is why stock backtests are month-end granularity.
# Note: `symbol=IBM&apikey=demo` works unmetered forever — the free smoke test.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Twelve Data — 800/day, 8/min. Stock DISPLAY charts (unadjusted is fine for a
# visual) plus crypto assets Coinbase does not list.
# https://twelvedata.com → free API key
TWELVE_DATA_API_KEY=

# Finnhub — 60/min. Real-time US quotes, company news, market news, profiles,
# basic financials. Note: historical OHLC is premium-only (403 on free), so
# Finnhub cannot power charts.
# https://finnhub.io/register
FINNHUB_API_KEY=

# CoinGecko — Demo tier, 100/min, 10k/month. Crypto catalog and metadata
# (logos, market-cap rank). NOT usable for backtests: the free plan caps
# historical data at 365 days, plan-wide.
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Coinbase Exchange needs no credentials — it is the primary source of deep
# crypto history (BTC from 2016). No variable required.

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
# Guards /api/cron/refresh-cache. Vercel Hobby crons run at most once per day.
# openssl rand -hex 24
CRON_SECRET=
